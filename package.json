{
  "name": "xcap-scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XCap Scan — multi-wallet transaction list, runs entirely in the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "test": "node --import tsx --test tests/*.test.mts",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.49.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
